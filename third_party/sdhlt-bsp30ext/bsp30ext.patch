diff --git a/src/sdhlt/common/bspfile.h b/src/sdhlt/common/bspfile.h
index ab50540..b82c26f 100644
--- a/src/sdhlt/common/bspfile.h
+++ b/src/sdhlt/common/bspfile.h
@@ -35,7 +35,11 @@
 
 #define MAX_MAP_NODES        32767
 // hard limit (negative short's are used as contents values)
-#define MAX_MAP_CLIPNODES    32767
+// mohaa-gc BSP30ext: clipnodes are int32 in memory. Maps with fewer than 32767 are
+// written as stock BSP30; larger ones get Xash3D's "XASH" extra header and a
+// 32-bit clipnode lump (engine/common/mod_bmodel.c, LUMP_BSP30EXT).
+#define MAX_MAP_CLIPNODES_HLBSP 32767
+#define MAX_MAP_CLIPNODES    262144
 // hard limit (negative short's are used as contents values)
 
 #define MAX_MAP_LEAFS        32760
@@ -216,9 +220,27 @@ dnode_t;
 typedef struct
 {
     int             planenum;
-    short           children[2];                           // negative numbers are contents
+    int             children[2];                           // negative numbers are contents
 }
-dclipnode_t;
+dclipnode_t;                                               // in memory, and on disk in BSP30ext
+
+typedef struct
+{
+    int             planenum;
+    short           children[2];
+}
+dclipnode16_t;                                             // stock BSP30 on disk
+
+#define IDEXTRAHEADER   (('X' << 0) | ('A' << 8) | ('S' << 16) | ('H' << 24))
+#define EXTRA_VERSION   4
+#define EXTRA_LUMPS     12
+typedef struct
+{
+    int             id;
+    int             version;
+    lump_t          lumps[EXTRA_LUMPS];
+}
+dextrahdr_t;
 
